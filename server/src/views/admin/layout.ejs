<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title><%= typeof pageTitle !== 'undefined' ? pageTitle : 'Admin' %> — LinkMind Admin</title>
<style>
  :root {
    --bg: #f5f5f5; --surface: #fff; --border: #ddd; --text: #1a1a1a;
    --dim: #777; --accent: #2075b0; --green: #2a9d6e;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #0f0f0f; --surface: #1a1a1a; --border: #2a2a2a; --text: #e0e0e0;
      --dim: #888; --accent: #4ea8de; --green: #4ecca3;
    }
  }
  * { margin: 0; padding: 0; box-sizing: border-box; }
  body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; background: var(--bg); color: var(--text); font-size: 14px; line-height: 1.5; }
  a { color: var(--accent); text-decoration: none; }
  a:hover { text-decoration: underline; }
  nav { padding: 10px 16px; border-bottom: 1px solid var(--border); font-size: 13px; display: flex; align-items: center; gap: 16px; }
  nav .brand { font-weight: 700; font-size: 14px; color: var(--text); margin-right: 8px; }
  main { padding: 16px; max-width: 1200px; }
  h2 { font-size: 18px; margin-bottom: 12px; }
  h3 { font-size: 15px; margin: 20px 0 8px; color: var(--dim); }
  table { border-collapse: collapse; width: 100%; }
  th, td { text-align: left; padding: 5px 10px; border-bottom: 1px solid var(--border); font-size: 13px; }
  th { font-weight: 600; font-size: 11px; text-transform: uppercase; color: var(--dim); }
  tr:hover { background: var(--surface); }
  code, .mono { font-family: 'SF Mono', 'Menlo', 'Consolas', monospace; font-size: 12px; }
  .stats { display: flex; gap: 32px; margin: 12px 0 20px; }
  .stat-value { font-size: 28px; font-weight: 700; }
  .stat-label { font-size: 12px; color: var(--dim); }
  .badge { display: inline-block; padding: 1px 6px; border-radius: 3px; font-size: 11px; font-weight: 500; }
  .badge-error { background: #fde8e8; color: #c53030; }
  .badge-analyzed { background: #e6f4ea; color: #1a7f4b; }
  .badge-pending, .badge-enqueued { background: #eee; color: #777; }
  .badge-scraped { background: #e3edf7; color: #2075b0; }
  .badge-waiting_probe { background: #fff3cd; color: #856404; }
  @media (prefers-color-scheme: dark) {
    .badge-error { background: #3a1a1a; color: #e88; }
    .badge-analyzed { background: #1a3a2a; color: #4ecca3; }
    .badge-pending, .badge-enqueued { background: #2a2a2a; color: #888; }
    .badge-scraped { background: #1a2a3a; color: #8ae; }
    .badge-waiting_probe { background: #3a3520; color: #dda; }
  }
  .pagination { margin: 12px 0; font-size: 13px; }
  .pagination a, .pagination span { margin-right: 8px; }
  .pagination .current { font-weight: 700; }
  .truncate { max-width: 400px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .dim { color: var(--dim); }
  dl { display: grid; grid-template-columns: 160px 1fr; gap: 2px 12px; font-size: 13px; }
  dt { font-weight: 600; color: var(--dim); padding: 4px 0; }
  dd { padding: 4px 0; word-break: break-all; }
  pre.data { background: var(--surface); border: 1px solid var(--border); padding: 8px; border-radius: 4px; font-size: 12px; overflow-x: auto; max-height: 400px; overflow-y: auto; white-space: pre-wrap; word-break: break-all; }
</style>
</head>
<body>
<nav>
  <a class="brand" href="/admin">LinkMind Admin</a>
  <a href="/admin">Dashboard</a>
  <a href="/admin/users">Users</a>
  <a href="/admin/invites">Invites</a>
  <a href="/admin/records">Records</a>
  <span style="flex:1;"></span>
  <a href="/" class="dim">Site</a>
  <a href="/admin/logout" class="dim">Logout</a>
</nav>
<main>
  <%- body %>
</main>
</body>
</html>
