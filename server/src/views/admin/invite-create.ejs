<h2>Create Invite</h2>

<form method="POST" action="/admin/invites/create" style="margin-top:12px;">
  <label style="font-size:13px;display:block;margin-bottom:4px;">Max Uses</label>
  <input type="number" name="max_uses" value="1" min="1" style="padding:4px 8px;font-size:13px;border:1px solid var(--border);border-radius:3px;background:var(--surface);color:var(--text);width:100px;">
  <button type="submit" style="margin-left:8px;padding:4px 12px;font-size:13px;border:1px solid var(--border);border-radius:3px;background:var(--accent);color:#fff;cursor:pointer;">Create</button>
</form>
