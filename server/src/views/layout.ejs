<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title><%= typeof pageTitle !== 'undefined' ? pageTitle : 'LinkMind' %></title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&display=swap" rel="stylesheet">
<style>
  :root {
    --bg: #f4f4f3;
    --surface: #ffffff;
    --border: #ddddda;
    --border-light: #e8e8e5;
    --border-row: #eeeeec;
    --head-bg: #fafaf9;
    --text: #26282b;
    --body-text: #3a3d40;
    --dim: #6b6e73;
    --faint: #8b8e93;
    --fainter: #a0a3a8;
    --accent: oklch(0.5 0.11 200);
    --accent-dark: oklch(0.42 0.11 200);
    --accent-bg: oklch(0.975 0.008 200);
    --tag-bg: #eaeae8;
    --tag-bg-hover: #dededb;
    --mono: 'IBM Plex Mono', ui-monospace, monospace;
    --error-bg: #fde8e8;
    --error-text: #c53030;
    --badge-pending-bg: #eaeae8;
    --badge-pending-text: #6b6e73;
    --badge-scraped-bg: oklch(0.95 0.02 200);
    --badge-scraped-text: oklch(0.42 0.11 200);
  }
  * { margin: 0; padding: 0; box-sizing: border-box; }
  body {
    font-family: -apple-system, "Helvetica Neue", "PingFang SC", "Microsoft YaHei", sans-serif;
    background: var(--bg);
    color: var(--text);
    line-height: 1.7;
    -webkit-font-smoothing: antialiased;
  }
  a { color: var(--accent); text-decoration: none; }
  a:hover { color: var(--accent-dark); text-decoration: underline; }
  .site-header {
    background: var(--surface);
    border-bottom: 1px solid var(--border);
    position: sticky;
    top: 0;
    z-index: 20;
  }
  .site-header-inner {
    max-width: 1080px;
    margin: 0 auto;
    padding: 0 24px;
    height: 48px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .site-header .brand {
    font-size: 14px;
    font-weight: 700;
    color: var(--text);
    letter-spacing: .01em;
    text-decoration: none;
  }
  .site-header .brand:hover { color: var(--text); text-decoration: none; }
  .site-header .nav-link {
    font-size: 12.5px;
    color: var(--dim);
    text-decoration: none;
  }
  .site-header .nav-link:hover { color: var(--text); text-decoration: none; }
  .page-body {
    max-width: 1080px;
    margin: 0 auto;
    padding: 24px 24px 64px;
  }
  @media (max-width: 600px) {
    .site-header-inner { padding: 0 16px; }
    .page-body { padding: 16px 12px 48px; }
  }
</style>
<%- typeof extraStyles !== 'undefined' ? extraStyles : '' %>
</head>
<body>
<header class="site-header">
  <div class="site-header-inner">
    <a class="brand" href="/">LinkMind</a>
    <% if (typeof user !== 'undefined' && user) { %>
    <a class="nav-link" href="/settings">Settings</a>
    <% } %>
  </div>
</header>
<div class="page-body">
  <%- body %>
</div>
</body>
</html>
