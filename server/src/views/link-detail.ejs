<%
  // Encode a text fragment value: only encode spaces and dashes (dash is special in text fragment syntax)
  function encodeTextFragment(text) {
    return text.replace(/-/g, '%2D').replace(/ /g, '%20');
  }

  // Extract a clean text fragment for scroll-to-text-fragment (#:~:text=...)
  // Supports multi-line snippets via textStart,textEnd syntax
  function textFragmentUrl(baseUrl, snippet) {
    if (!baseUrl || !snippet) return baseUrl || '';
    // Strip qmd diff-style headers like "@@ -74,4 @@ (73 before, 3 after)\n\n"
    let clean = snippet.replace(/^@@[^@]*@@[^\n]*\n*/g, '').trim();
    // Remove trailing ellipsis (…, ..., etc.)
    clean = clean.replace(/[.…]{2,}$|…$/g, '').trim();
    if (!clean) return baseUrl;

    const lines = clean.split('\n').map(l => l.trim()).filter(l => l.length > 0);
    if (lines.length === 0) return baseUrl;

    if (lines.length === 1) {
      // Single line: use textStart only, cap at 80 chars on word boundary
      let text = lines[0];
      if (text.length > 80) {
        text = text.slice(0, 80).replace(/\s+\S*$/, '');
      }
      if (!text) return baseUrl;
      return baseUrl + '#:~:text=' + encodeTextFragment(text);
    }

    // Multi-line: use textStart,textEnd to span across line breaks
    let textStart = lines[0];
    let textEnd = lines[lines.length - 1];
    // Cap textStart at 80 chars (from start, break at word boundary)
    if (textStart.length > 80) {
      textStart = textStart.slice(0, 80).replace(/\s+\S*$/, '');
    }
    // Cap textEnd at 80 chars (from end, break at word boundary)
    if (textEnd.length > 80) {
      textEnd = textEnd.slice(-80).replace(/^\S*\s+/, '');
    }
    if (!textStart || !textEnd) return baseUrl;
    return baseUrl + '#:~:text=' + encodeTextFragment(textStart) + ',' + encodeTextFragment(textEnd);
  }

  // Extract filename (without .md) from a qmd path like "qmd://notes/folder/my-note.md"
  function noteFilename(path) {
    if (!path) return 'Untitled';
    return path.split('/').pop().replace(/\.md$/i, '') || 'Untitled';
  }
%>
<style>
  .detail-layout {
    display: flex;
    gap: 24px;
    align-items: flex-start;
  }
  .detail-main {
    flex: 1;
    min-width: 0;
  }
  .detail-sidebar {
    width: 280px;
    flex-shrink: 0;
  }
  .detail-main h1 {
    font-size: 1.5rem;
    margin-bottom: 8px;
    line-height: 1.4;
  }
  .meta {
    color: var(--dim);
    font-size: 0.85rem;
    margin-bottom: 24px;
    word-break: break-all;
  }
  .meta a { color: var(--accent); }
  .section {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 20px;
    margin-bottom: 16px;
  }
  .section-title {
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--dim);
    margin-bottom: 10px;
    font-weight: 600;
  }
  .insight {
    border-left: 3px solid var(--green);
    padding-left: 16px;
  }
  .content {
    font-size: 0.95rem;
    word-break: break-word;
    max-height: 600px;
    overflow-y: auto;
  }
  /* Markdown rendered content */
  .markdown-body {
    font-size: 0.95rem;
    line-height: 1.7;
    word-break: break-word;
  }
  .markdown-body h1, .markdown-body h2, .markdown-body h3,
  .markdown-body h4, .markdown-body h5, .markdown-body h6 {
    margin-top: 1em;
    margin-bottom: 0.5em;
    line-height: 1.3;
  }
  .markdown-body h1 { font-size: 1.3rem; }
  .markdown-body h2 { font-size: 1.15rem; }
  .markdown-body h3 { font-size: 1.05rem; }
  .markdown-body p { margin: 0.6em 0; }
  .markdown-body ul, .markdown-body ol { padding-left: 1.5em; margin: 0.5em 0; }
  .markdown-body li { margin: 0.25em 0; }
  .markdown-body code {
    background: var(--border);
    padding: 1px 5px;
    border-radius: 3px;
    font-size: 0.88em;
  }
  .markdown-body pre {
    background: var(--border);
    padding: 12px 16px;
    border-radius: 6px;
    overflow-x: auto;
    margin: 0.8em 0;
  }
  .markdown-body pre code {
    background: none;
    padding: 0;
  }
  .markdown-body blockquote {
    border-left: 3px solid var(--dim);
    padding-left: 12px;
    margin: 0.6em 0;
    color: var(--dim);
  }
  .markdown-body table {
    border-collapse: collapse;
    width: 100%;
    margin: 0.8em 0;
  }
  .markdown-body th, .markdown-body td {
    border: 1px solid var(--border);
    padding: 6px 10px;
    text-align: left;
  }
  .markdown-body th { font-weight: 600; }
  .markdown-body img { max-width: 100%; border-radius: 4px; }
  .markdown-body a { color: var(--accent); }
  .markdown-body hr { border: none; border-top: 1px solid var(--border); margin: 1em 0; }
  /* Sidebar styles */
  .og-image {
    width: 100%;
    border-radius: 6px;
    margin-bottom: 16px;
  }
  .tags {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
  }
  .tag {
    background: var(--border);
    color: var(--dim);
    padding: 2px 10px;
    border-radius: 12px;
    font-size: 0.8rem;
  }
  .related-item {
    padding: 6px 0;
    border-bottom: 1px solid var(--border);
    font-size: 0.9rem;
    overflow-wrap: break-word;
    word-break: break-all;
  }
  .related-item:last-child { border-bottom: none; }
  .related-item a { color: var(--accent); }
  .related-heading {
    color: var(--dim);
    font-size: 0.8rem;
    margin-left: 4px;
  }
  .related-snippet {
    color: var(--dim);
    font-size: 0.8rem;
  }
  .related-tags {
    color: var(--dim);
    font-size: 0.75rem;
  }
  .related-score {
    color: var(--dim);
    font-size: 0.75rem;
    margin-left: 6px;
  }
  /* Image gallery */
  .image-gallery {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 16px;
  }
  .image-gallery figure {
    margin: 0;
    background: var(--bg);
    border-radius: 6px;
    overflow: hidden;
  }
  .image-gallery img {
    width: 100%;
    height: auto;
    display: block;
    cursor: pointer;
    transition: transform 0.2s;
  }
  .image-gallery img:hover {
    transform: scale(1.02);
  }
  .image-gallery figcaption {
    padding: 8px 12px;
    font-size: 0.8rem;
    color: var(--dim);
    background: var(--surface);
    border-top: 1px solid var(--border);
    white-space: pre-wrap;
    max-height: 120px;
    overflow-y: auto;
  }

  /* Rerun button */
  .rerun-bar {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 16px;
  }
  .btn-rerun {
    background: var(--accent);
    color: #fff;
    border: none;
    padding: 6px 16px;
    border-radius: 6px;
    font-size: 0.85rem;
    cursor: pointer;
  }
  .btn-rerun:hover { opacity: 0.9; }
  .btn-rerun:disabled { opacity: 0.5; cursor: not-allowed; }
  .rerun-status {
    font-size: 0.85rem;
    color: var(--dim);
  }

  /* Processing history */
  .event-timeline {
    font-size: 0.85rem;
  }
  .event-item {
    display: flex;
    gap: 10px;
    padding: 4px 0;
    border-bottom: 1px solid var(--border);
  }
  .event-item:last-child { border-bottom: none; }
  .event-time {
    color: var(--dim);
    white-space: nowrap;
    font-family: monospace;
    font-size: 0.8rem;
  }
  .event-body { flex: 1; }
  .event-type {
    display: inline-block;
    padding: 1px 6px;
    border-radius: 4px;
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    margin-right: 6px;
  }
  .event-type-step_start { background: var(--badge-scraped-bg); color: var(--badge-scraped-text); }
  .event-type-step_end { background: #e8f5e9; color: #2e7d32; }
  .event-type-message { background: var(--badge-pending-bg); color: var(--badge-pending-text); }
  .event-type-session_start { background: #e3f2fd; color: #1565c0; }
  .event-type-session_end { background: #fce4ec; color: #c62828; }
  @media (prefers-color-scheme: dark) {
    .event-type-step_end { background: #1b3a1b; color: #6ec86e; }
    .event-type-session_start { background: #1a2a3a; color: #4ea8de; }
    .event-type-session_end { background: #3a1a1a; color: #e88; }
  }
  .event-duration {
    color: var(--dim);
    font-size: 0.8rem;
    margin-left: 4px;
  }
  .session-badge {
    display: inline-block;
    padding: 2px 8px;
    border-radius: 4px;
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
  }
  .session-running { background: #fff3e0; color: #e65100; }
  .session-completed { background: #e8f5e9; color: #2e7d32; }
  .session-failed { background: var(--error-bg); color: var(--error-text); }
  @media (prefers-color-scheme: dark) {
    .session-running { background: #3a2a10; color: #ffb74d; }
    .session-completed { background: #1b3a1b; color: #6ec86e; }
  }

  @media (max-width: 768px) {
    .detail-layout {
      flex-direction: column;
    }
    .detail-sidebar {
      width: 100%;
    }
  }
</style>

<div class="detail-layout">
  <div class="detail-main">
    <% if (link.type === 'note') { %>
    <h1>笔记</h1>
    <div class="meta">
      <% if (link.source_url) { %><a href="<%= link.source_url %>" target="_blank">来源链接</a> · <% } %>
      <%= link.created_at || '' %>
    </div>

    <div class="section">
      <div class="section-title">内容</div>
      <div class="content markdown-body"><%- contentHtml %></div>
    </div>

    <% if (link.user_note) { %>
    <div class="section">
      <div class="section-title">备注</div>
      <div class="content"><%= link.user_note %></div>
    </div>
    <% } %>

    <% if (link.summary && link.summary !== link.content) { %>
    <div class="section">
      <div class="section-title">摘要</div>
      <div class="markdown-body"><%- summaryHtml %></div>
    </div>
    <% } %>

    <% if (link.insight) { %>
    <div class="section">
      <div class="section-title">Insight</div>
      <div class="insight markdown-body"><%- insightHtml %></div>
    </div>
    <% } %>

    <% } else { %>
    <h1><%= link.og_title || 'Untitled' %></h1>
    <div class="meta">
      <a href="<%= link.url %>" target="_blank"><%= link.url %></a>
      <% if (link.og_site_name) { %>· <%= link.og_site_name %><% } %>
      · <%= link.created_at || '' %>
    </div>

    <% if (link.user_note) { %>
    <div class="section">
      <div class="section-title">备注</div>
      <div class="content"><%= link.user_note %></div>
    </div>
    <% } %>

    <% if (link.summary) { %>
    <div class="section">
      <div class="section-title">摘要</div>
      <div class="markdown-body"><%- summaryHtml %></div>
    </div>
    <% } %>

    <% if (link.insight) { %>
    <div class="section">
      <div class="section-title">Insight</div>
      <div class="insight markdown-body"><%- insightHtml %></div>
    </div>
    <% } %>

    <% if (images && images.length > 0) { %>
    <div class="section">
      <div class="section-title">图片</div>
      <div class="image-gallery">
        <% for (const img of images) { %>
        <figure>
          <a href="/images/<%= link.id %>/<%= img.local_path %>" target="_blank">
            <img src="/images/<%= link.id %>/<%= img.local_path %>" loading="lazy" alt="">
          </a>
          <% if (img.ocr_text) { %>
          <figcaption><%= img.ocr_text %></figcaption>
          <% } %>
        </figure>
        <% } %>
      </div>
    </div>
    <% } %>

    <% if (link.markdown) { %>
    <div class="section">
      <div class="section-title">原文内容</div>
      <div class="content markdown-body"><%- markdownHtml %></div>
    </div>
    <% } %>
    <% } %>
  </div>

  <div class="detail-sidebar">
    <% if (link.og_image) { %>
    <img class="og-image" src="<%= link.og_image %>" alt="">
    <% } %>

    <% if (tags.length > 0) { %>
    <div class="section">
      <div class="section-title">标签</div>
      <div class="tags">
        <% for (const t of tags) { %>
        <span class="tag"><%= t %></span>
        <% } %>
      </div>
    </div>
    <% } %>

    <% if (relatedNotes.length > 0) { %>
    <div class="section">
      <div class="section-title">相关笔记</div>
      <% for (const n of relatedNotes) { %>
      <div class="related-item">
        <%
          const noteName = noteFilename(n.path);
          // heading: prefer dedicated field, fall back to title if it differs from filename
          const heading = n.heading || (n.title && n.title !== noteName ? n.title : '');
        %>
        <% if (n.noteUrl) { %>
        📝 <a href="<%= textFragmentUrl(n.noteUrl, n.snippet) %>"><%= noteName %></a>
        <% } else { %>
        📝 <%= noteName %>
        <% } %>
        <% if (heading) { %>
        <br><span class="related-heading">§ <%= heading %></span>
        <% } %>
        <% if (n.snippet) { %>
        <br><span class="related-snippet"><%= n.snippet.slice(0, 150) %></span>
        <% } %>
      </div>
      <% } %>
    </div>
    <% } %>

    <% if (relatedLinks.length > 0) { %>
    <div class="section">
      <div class="section-title">相关链接</div>
      <% for (const l of relatedLinks) { %>
      <div class="related-item">
        🔗 <a href="<%= l.url %>"><%= l.title || l.url || '' %></a> (<a href="<%= l.sourceUrl %>" target="_blank">Source</a>)<% if (l.score) { %><span class="related-score">[<%= l.score %>]</span><% } %>
        <% if (l.tags && l.tags.length > 0) { %>
        <br><span class="related-tags"><%= l.tags.map(t => '#' + t).join(' ') %></span>
        <% } %>
      </div>
      <% } %>
    </div>
    <% } %>
  </div>
</div>

<%
  const session = typeof agentSession !== 'undefined' ? agentSession : null;
  const events = typeof agentEvents !== 'undefined' ? agentEvents : [];

  function formatEventTime(dateStr) {
    if (!dateStr) return '';
    const d = new Date(dateStr);
    return d.toLocaleTimeString('zh-CN', { hour12: false });
  }

  function formatDuration(ms) {
    if (ms == null) return '';
    if (ms < 1000) return ms + 'ms';
    return (ms / 1000).toFixed(1) + 's';
  }

  function eventLabel(evt) {
    if (evt.event_type === 'step_start') return evt.name || 'step';
    if (evt.event_type === 'step_end') return evt.name || 'step';
    if (evt.event_type === 'message') {
      const data = typeof evt.data === 'string' ? JSON.parse(evt.data) : evt.data;
      return data?.message || 'message';
    }
    if (evt.event_type === 'session_start') return 'Session started';
    if (evt.event_type === 'session_end') {
      const data = typeof evt.data === 'string' ? JSON.parse(evt.data) : evt.data;
      return data?.status === 'failed' ? 'Session failed' : 'Session completed';
    }
    return evt.event_type;
  }

  function eventDuration(evt) {
    if (evt.event_type !== 'step_end') return null;
    const data = typeof evt.data === 'string' ? JSON.parse(evt.data) : evt.data;
    return data?.durationMs;
  }
%>

<div class="rerun-bar">
  <button class="btn-rerun" id="rerunBtn" onclick="rerunRecord()">Rerun</button>
  <span class="rerun-status" id="rerunStatus">
    <% if (session) { %>
      <span class="session-badge session-<%= session.status %>"><%= session.status %></span>
      <%= session.agent_name %> &middot; <%= formatEventTime(session.created_at) %>
    <% } %>
  </span>
</div>

<% if (events.length > 0 || (session && session.status === 'running')) { %>
<div class="section">
  <div class="section-title">Processing History</div>
  <div class="event-timeline" id="eventTimeline">
    <% for (const evt of events) { %>
    <div class="event-item">
      <span class="event-time"><%= formatEventTime(evt.created_at) %></span>
      <span class="event-body">
        <span class="event-type event-type-<%= evt.event_type %>"><%= evt.event_type.replace('_', ' ') %></span>
        <%= eventLabel(evt) %>
        <% const dur = eventDuration(evt); if (dur != null) { %>
          <span class="event-duration">(<%= formatDuration(dur) %>)</span>
        <% } %>
      </span>
    </div>
    <% } %>
  </div>
</div>
<% } %>

<script>
  const recordId = <%= link.id %>;
  const initialSessionId = '<%= session ? session.id : '' %>';
  const initialSessionStatus = '<%= session ? session.status : '' %>';

  function rerunRecord() {
    const btn = document.getElementById('rerunBtn');
    const status = document.getElementById('rerunStatus');
    btn.disabled = true;
    btn.textContent = 'Rerunning...';
    status.textContent = 'Starting...';

    fetch('/api/retry/' + recordId, { method: 'POST' })
      .then(r => r.json())
      .then(data => {
        status.textContent = 'Queued (taskId: ' + (data.taskId || '?') + ')';
        // Start polling for new session
        setTimeout(() => pollForSession(), 2000);
      })
      .catch(err => {
        btn.disabled = false;
        btn.textContent = 'Rerun';
        status.textContent = 'Error: ' + err.message;
      });
  }

  function pollForSession() {
    fetch('/api/records/' + recordId + '/session')
      .then(r => r.json())
      .then(data => {
        if (data.session && data.session.status === 'running') {
          startSSE(data.session.id);
        } else {
          // Session not ready yet, keep polling
          setTimeout(() => pollForSession(), 1000);
        }
      });
  }

  function startSSE(sessionId) {
    const timeline = document.getElementById('eventTimeline');
    if (!timeline) {
      // Create timeline section if it doesn't exist yet
      const section = document.createElement('div');
      section.className = 'section';
      section.innerHTML = '<div class="section-title">Processing History</div><div class="event-timeline" id="eventTimeline"></div>';
      document.querySelector('.rerun-bar').after(section);
    }
    const tl = document.getElementById('eventTimeline');
    tl.innerHTML = '';

    const es = new EventSource('/api/agent-events/stream?session_id=' + sessionId + '&cursor=0');
    es.addEventListener('agent_event', function(e) {
      const evt = JSON.parse(e.data);
      const item = document.createElement('div');
      item.className = 'event-item';

      const time = new Date(evt.created_at).toLocaleTimeString('zh-CN', { hour12: false });
      const typeClass = 'event-type-' + evt.event_type;
      const typeLabel = evt.event_type.replace('_', ' ');

      let label = '';
      if (evt.event_type === 'step_start' || evt.event_type === 'step_end') {
        label = evt.name || 'step';
      } else if (evt.event_type === 'message') {
        const data = typeof evt.data === 'string' ? JSON.parse(evt.data) : evt.data;
        label = data?.message || 'message';
      } else if (evt.event_type === 'session_start') {
        label = 'Session started';
      } else if (evt.event_type === 'session_end') {
        const data = typeof evt.data === 'string' ? JSON.parse(evt.data) : evt.data;
        label = data?.status === 'failed' ? 'Session failed' : 'Session completed';
      }

      let durHtml = '';
      if (evt.event_type === 'step_end') {
        const data = typeof evt.data === 'string' ? JSON.parse(evt.data) : evt.data;
        if (data?.durationMs != null) {
          const ms = data.durationMs;
          durHtml = ' <span class="event-duration">(' + (ms < 1000 ? ms + 'ms' : (ms/1000).toFixed(1) + 's') + ')</span>';
        }
      }

      item.innerHTML = '<span class="event-time">' + time + '</span>' +
        '<span class="event-body"><span class="event-type ' + typeClass + '">' + typeLabel + '</span> ' +
        label + durHtml + '</span>';

      tl.appendChild(item);
      tl.scrollTop = tl.scrollHeight;

      // Update status bar on session_end
      if (evt.event_type === 'session_end') {
        es.close();
        const btn = document.getElementById('rerunBtn');
        btn.disabled = false;
        btn.textContent = 'Rerun';
        const data = typeof evt.data === 'string' ? JSON.parse(evt.data) : evt.data;
        const statusEl = document.getElementById('rerunStatus');
        const statusClass = data?.status === 'failed' ? 'session-failed' : 'session-completed';
        statusEl.innerHTML = '<span class="session-badge ' + statusClass + '">' + (data?.status || 'done') + '</span>';
      }
    });

    es.onerror = function() {
      es.close();
      const btn = document.getElementById('rerunBtn');
      btn.disabled = false;
      btn.textContent = 'Rerun';
    };
  }

  // Auto-connect SSE if session is running on page load
  if (initialSessionStatus === 'running' && initialSessionId) {
    startSSE(initialSessionId);
  }
</script>
