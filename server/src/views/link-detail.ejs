<%
  // Encode a text fragment value: only encode spaces and dashes (dash is special in text fragment syntax)
  function encodeTextFragment(text) {
    return text.replace(/-/g, '%2D').replace(/ /g, '%20');
  }

  // Extract a clean text fragment for scroll-to-text-fragment (#:~:text=...)
  // Supports multi-line snippets via textStart,textEnd syntax
  function textFragmentUrl(baseUrl, snippet) {
    if (!baseUrl || !snippet) return baseUrl || '';
    // Strip qmd diff-style headers like "@@ -74,4 @@ (73 before, 3 after)\n\n"
    let clean = snippet.replace(/^@@[^@]*@@[^\n]*\n*/g, '').trim();
    // Remove trailing ellipsis (…, ..., etc.)
    clean = clean.replace(/[.…]{2,}$|…$/g, '').trim();
    if (!clean) return baseUrl;

    const lines = clean.split('\n').map(l => l.trim()).filter(l => l.length > 0);
    if (lines.length === 0) return baseUrl;

    if (lines.length === 1) {
      // Single line: use textStart only, cap at 80 chars on word boundary
      let text = lines[0];
      if (text.length > 80) {
        text = text.slice(0, 80).replace(/\s+\S*$/, '');
      }
      if (!text) return baseUrl;
      return baseUrl + '#:~:text=' + encodeTextFragment(text);
    }

    // Multi-line: use textStart,textEnd to span across line breaks
    let textStart = lines[0];
    let textEnd = lines[lines.length - 1];
    // Cap textStart at 80 chars (from start, break at word boundary)
    if (textStart.length > 80) {
      textStart = textStart.slice(0, 80).replace(/\s+\S*$/, '');
    }
    // Cap textEnd at 80 chars (from end, break at word boundary)
    if (textEnd.length > 80) {
      textEnd = textEnd.slice(-80).replace(/^\S*\s+/, '');
    }
    if (!textStart || !textEnd) return baseUrl;
    return baseUrl + '#:~:text=' + encodeTextFragment(textStart) + ',' + encodeTextFragment(textEnd);
  }

  // Extract filename (without .md) from a qmd path like "qmd://notes/folder/my-note.md"
  function noteFilename(path) {
    if (!path) return 'Untitled';
    return path.split('/').pop().replace(/\.md$/i, '') || 'Untitled';
  }
%>
<style>
  .paper {
    max-width: 880px;
    margin: 0 auto;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 2px;
    padding: 34px 0 48px;
  }
  .paper-inner {
    max-width: 700px;
    margin: 0 auto;
    padding: 0 32px;
  }
  .back-link {
    font-size: 12px;
    color: var(--dim);
  }
  .back-link:hover { color: var(--text); text-decoration: none; }

  /* 标题区 */
  .title-row {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 16px;
    margin-top: 20px;
  }
  .title-row h1 {
    margin: 0;
    font-size: 27px;
    font-weight: 700;
    line-height: 1.3;
    overflow-wrap: break-word;
    word-break: break-word;
    min-width: 0;
  }
  .btn-chip {
    flex: none;
    font-size: 11.5px;
    font-weight: 600;
    padding: 5px 12px;
    background: var(--surface);
    border: 1px solid #c8c8c5;
    border-radius: 2px;
    cursor: pointer;
    color: var(--text);
    font-family: inherit;
  }
  .btn-chip:hover { border-color: var(--text); }
  .btn-chip:disabled { opacity: 0.5; cursor: not-allowed; }
  .btn-chip--active { border-color: var(--accent); color: var(--accent); }
  .source-meta {
    margin-top: 10px;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .source-meta .src-url {
    font-size: 12.5px;
    word-break: break-all;
  }
  .source-meta .src-line {
    font-family: var(--mono);
    font-size: 10.5px;
    color: var(--faint);
    word-break: break-all;
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 14px;
  }
  .tag {
    font-size: 11px;
    padding: 3px 9px;
    background: var(--tag-bg);
    color: var(--body-text);
    border-radius: 2px;
  }
  .divider {
    height: 1px;
    background: var(--border-light);
    margin: 26px 0 24px;
  }
  .section-h2 {
    margin: 0 0 14px;
    font-size: 17px;
    font-weight: 700;
    line-height: 1.4;
  }
  .section-h2 .h2-count {
    font-family: var(--mono);
    font-size: 10.5px;
    font-weight: 400;
    color: var(--faint);
  }

  /* Markdown 内文排版 */
  .markdown-body {
    font-size: 13.5px;
    color: var(--body-text);
    line-height: 1.8;
    word-break: break-word;
  }
  .markdown-body > p:first-child { font-size: 14.5px; line-height: 1.9; }
  .markdown-body h1, .markdown-body h2, .markdown-body h3,
  .markdown-body h4, .markdown-body h5, .markdown-body h6 {
    margin: 24px 0 6px;
    font-size: 13.5px;
    font-weight: 700;
    color: var(--text);
    line-height: 1.5;
  }
  .markdown-body p { margin: 0.6em 0; }
  .markdown-body ul, .markdown-body ol { padding-left: 1.4em; margin: 0.5em 0; }
  .markdown-body li { margin: 0.45em 0; }
  .markdown-body li::marker { color: var(--fainter); }
  .markdown-body code {
    background: var(--tag-bg);
    padding: 1px 5px;
    border-radius: 2px;
    font-family: var(--mono);
    font-size: 0.88em;
  }
  .markdown-body pre {
    background: var(--head-bg);
    border: 1px solid var(--border-light);
    padding: 12px 16px;
    border-radius: 2px;
    overflow-x: auto;
    margin: 0.8em 0;
  }
  .markdown-body pre code { background: none; padding: 0; }
  .markdown-body blockquote {
    border-left: 2px solid var(--border);
    padding: 2px 0 2px 12px;
    margin: 6px 0;
  }
  .markdown-body blockquote p {
    font-size: 12px;
    color: var(--dim);
    line-height: 1.65;
    margin: 0.3em 0;
  }
  .markdown-body table {
    border-collapse: collapse;
    width: 100%;
    margin: 0.8em 0;
  }
  .markdown-body th, .markdown-body td {
    border: 1px solid var(--border-light);
    padding: 6px 10px;
    text-align: left;
  }
  .markdown-body th { font-weight: 600; }
  .markdown-body img { max-width: 100%; border-radius: 2px; }
  .markdown-body hr { border: none; border-top: 1px solid var(--border-light); margin: 1em 0; }

  /* INSIGHT */
  .insight-box {
    background: var(--accent-bg);
    border-left: 2px solid var(--accent);
    padding: 18px 22px 20px;
    margin-top: 30px;
  }
  .insight-box .box-label {
    font-family: var(--mono);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: .1em;
    color: var(--accent-dark);
    margin-bottom: 11px;
  }
  .insight-box .markdown-body { line-height: 1.85; }
  .insight-box .markdown-body > p:first-child { font-size: 13.5px; line-height: 1.85; }

  /* 折叠面板（原文内容 / 处理记录） */
  .fold {
    border: 1px solid var(--border);
    border-radius: 2px;
    margin-top: 30px;
    overflow: hidden;
  }
  .fold > summary {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 18px;
    background: var(--head-bg);
    cursor: pointer;
    list-style: none;
  }
  .fold > summary::-webkit-details-marker { display: none; }
  .fold > summary:hover { background: #f4f4f2; }
  .fold-title { font-size: 13px; font-weight: 700; }
  .fold-meta {
    font-family: var(--mono);
    font-size: 10px;
    color: var(--faint);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .fold-toggle {
    margin-left: auto;
    flex: none;
    font-size: 11.5px;
    color: var(--dim);
  }
  .fold .when-open { display: none; }
  .fold[open] .when-open { display: inline; }
  .fold[open] .when-closed { display: none; }
  .fold-body {
    padding: 18px 22px 22px;
    border-top: 1px solid var(--border-light);
  }

  /* 图片 */
  .image-gallery {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
    gap: 14px;
  }
  .image-gallery figure {
    margin: 0;
    background: var(--head-bg);
    border: 1px solid var(--border-light);
    border-radius: 2px;
    overflow: hidden;
  }
  .image-gallery img {
    width: 100%;
    height: auto;
    display: block;
    cursor: pointer;
  }
  .image-gallery figcaption {
    padding: 8px 12px;
    font-size: 11px;
    color: var(--dim);
    border-top: 1px solid var(--border-light);
    white-space: pre-wrap;
    max-height: 120px;
    overflow-y: auto;
  }

  /* 相关链接 / 相关笔记 */
  .related-item {
    padding: 16px 0;
    border-bottom: 1px solid #f0f0ee;
  }
  .related-item:last-child { border-bottom: none; }
  .related-title-row {
    display: flex;
    align-items: baseline;
    gap: 8px;
    min-width: 0;
  }
  .related-title-row a, .related-title-row .related-title {
    font-size: 13.5px;
    font-weight: 600;
    line-height: 1.5;
    overflow-wrap: break-word;
    word-break: break-word;
    min-width: 0;
  }
  .related-score {
    flex: none;
    font-family: var(--mono);
    font-size: 9.5px;
    color: var(--faint);
  }
  .related-quote {
    border-left: 2px solid var(--border);
    padding: 1px 0 1px 12px;
    margin-top: 9px;
  }
  .related-quote p {
    margin: 0;
    font-size: 12px;
    color: var(--dim);
    line-height: 1.7;
    overflow-wrap: break-word;
    word-break: break-word;
  }
  .related-quote .q-label {
    font-family: var(--mono);
    font-size: 9.5px;
    color: var(--fainter);
    margin-right: 6px;
  }
  .related-foot {
    margin-top: 8px;
    font-family: var(--mono);
    font-size: 10px;
    color: var(--faint);
    word-break: break-all;
  }
  .related-foot a { font-size: 10px; }

  /* 处理记录 */
  .pipe-badge {
    font-family: var(--mono);
    font-size: 9.5px;
    font-weight: 600;
    letter-spacing: .05em;
    padding: 3px 8px;
    background: var(--tag-bg);
    color: #55585c;
    border-radius: 2px;
    flex: none;
  }
  .pipe-badge.running { background: #fff3e0; color: #e65100; }
  .pipe-badge.failed { background: var(--error-bg); color: var(--error-text); }
  .mono-label {
    font-family: var(--mono);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: .1em;
    color: var(--faint);
    margin-bottom: 8px;
  }
  .btn-solid {
    font-size: 11.5px;
    font-weight: 600;
    padding: 5px 14px;
    background: var(--accent);
    color: #ffffff;
    border: none;
    border-radius: 2px;
    cursor: pointer;
    font-family: inherit;
  }
  .btn-solid:hover { background: var(--accent-dark); }
  .btn-solid:disabled { opacity: 0.5; cursor: not-allowed; }
  .rerun-status { font-family: var(--mono); font-size: 10.5px; color: var(--dim); }
  .event-item {
    display: grid;
    grid-template-columns: 74px 108px 1fr;
    gap: 12px;
    align-items: baseline;
    padding: 3.5px 0;
  }
  .event-time {
    font-family: var(--mono);
    font-size: 10.5px;
    color: var(--faint);
    white-space: nowrap;
  }
  .event-type {
    display: inline-block;
    font-family: var(--mono);
    font-size: 9px;
    font-weight: 600;
    letter-spacing: .04em;
    padding: 1.5px 6px;
    border-radius: 2px;
    white-space: nowrap;
    background: var(--tag-bg);
    color: #55585c;
  }
  .event-type.is-session { background: var(--text); color: #ffffff; }
  .event-text {
    font-family: var(--mono);
    font-size: 10.5px;
    color: var(--body-text);
    word-break: break-word;
  }
  .cost-row {
    display: grid;
    grid-template-columns: 90px 100px 110px 1fr;
    gap: 10px;
    padding: 4.5px 0;
    border-bottom: 1px solid #f4f4f2;
  }
  .cost-row span {
    font-family: var(--mono);
    font-size: 10.5px;
    color: var(--body-text);
  }
  .cost-row .c-dim { color: var(--dim); }

  @media (max-width: 600px) {
    .paper { padding: 24px 0 36px; }
    .paper-inner { padding: 0 18px; }
    .title-row h1 { font-size: 22px; }
    .event-item { grid-template-columns: 58px 92px 1fr; gap: 8px; }
    .cost-row { grid-template-columns: 70px 80px 90px 1fr; gap: 8px; }
  }
</style>

<div class="paper">
  <div class="paper-inner">

    <% if (typeof isShared === 'undefined' || !isShared) { %>
    <div style="margin-bottom:20px">
      <a class="back-link" href="/">← 返回列表</a>
    </div>
    <% } %>

    <% if (link.type === 'note') { %>

    <div class="title-row">
      <h1>笔记</h1>
      <% if (typeof isShared === 'undefined' || !isShared) { %>
        <% if (typeof shareNanoid !== 'undefined' && shareNanoid) { %>
        <button class="btn-chip btn-chip--active" id="shareBtn" onclick="stopSharing()">Stop Sharing</button>
        <% } else { %>
        <button class="btn-chip" id="shareBtn" onclick="shareRecord()">Share</button>
        <% } %>
      <% } %>
    </div>
    <div class="source-meta">
      <% if (link.source_url) { %>
      <a class="src-url" href="<%= link.source_url %>" target="_blank"><%= link.source_url %></a>
      <% } %>
      <span class="src-line"><%= link.created_at || '' %></span>
    </div>
    <% if (typeof shareNanoid !== 'undefined' && shareNanoid) { %>
    <div style="margin-top:8px;font-size:12px"><a href="/shared/<%= shareNanoid %>" target="_blank">/shared/<%= shareNanoid %></a></div>
    <% } %>

    <div class="divider"></div>

    <h2 class="section-h2">内容</h2>
    <div class="markdown-body"><%- contentHtml %></div>

    <% if (link.user_note) { %>
    <div class="divider"></div>
    <h2 class="section-h2">备注</h2>
    <div class="markdown-body"><p><%= link.user_note %></p></div>
    <% } %>

    <% if (link.summary && link.summary !== link.content) { %>
    <div class="divider"></div>
    <h2 class="section-h2">摘要</h2>
    <div class="markdown-body"><%- summaryHtml %></div>
    <% } %>

    <% if (link.insight) { %>
    <div class="insight-box">
      <div class="box-label">INSIGHT</div>
      <div class="markdown-body"><%- insightHtml %></div>
    </div>
    <% } %>

    <% } else { %>

    <div class="title-row">
      <h1><%= link.og_title || 'Untitled' %></h1>
      <% if (typeof isShared === 'undefined' || !isShared) { %>
        <% if (typeof shareNanoid !== 'undefined' && shareNanoid) { %>
        <button class="btn-chip btn-chip--active" id="shareBtn" onclick="stopSharing()">Stop Sharing</button>
        <% } else { %>
        <button class="btn-chip" id="shareBtn" onclick="shareRecord()">Share</button>
        <% } %>
      <% } %>
    </div>
    <div class="source-meta">
      <a class="src-url" href="<%= link.url %>" target="_blank"><%= link.url %></a>
      <span class="src-line"><%= typeof domain !== 'undefined' && domain ? domain : (link.og_site_name || '') %><%= link.created_at ? ' · ' + link.created_at : '' %></span>
    </div>
    <% if (typeof shareNanoid !== 'undefined' && shareNanoid) { %>
    <div style="margin-top:8px;font-size:12px"><a href="/shared/<%= shareNanoid %>" target="_blank">/shared/<%= shareNanoid %></a></div>
    <% } %>

    <% if (tags.length > 0) { %>
    <div class="tags">
      <% for (const t of tags) { %>
      <span class="tag"><%= t %></span>
      <% } %>
    </div>
    <% } %>

    <div class="divider"></div>

    <% if (link.user_note) { %>
    <h2 class="section-h2">备注</h2>
    <div class="markdown-body" style="margin-bottom:24px"><p><%= link.user_note %></p></div>
    <% } %>

    <% if (link.summary) { %>
    <h2 class="section-h2">摘要</h2>
    <div class="markdown-body"><%- summaryHtml %></div>
    <% } %>

    <% if (link.insight) { %>
    <div class="insight-box">
      <div class="box-label">INSIGHT</div>
      <div class="markdown-body"><%- insightHtml %></div>
    </div>
    <% } %>

    <% if (recordFiles && recordFiles.length > 0) { %>
    <details class="fold">
      <summary>
        <span class="fold-title">图片</span>
        <span class="fold-meta"><%= recordFiles.length %> 张</span>
        <span class="fold-toggle"><span class="when-closed">展开 ▾</span><span class="when-open">收起 ▴</span></span>
      </summary>
      <div class="fold-body">
        <div class="image-gallery">
          <% for (const rf of recordFiles) { %>
          <figure>
            <a href="/files/<%= rf.storage_key %>" target="_blank">
              <img src="/files/<%= rf.storage_key %>" loading="lazy" alt="">
            </a>
          </figure>
          <% } %>
        </div>
      </div>
    </details>
    <% } %>

    <% if (link.markdown) { %>
    <details class="fold">
      <summary>
        <span class="fold-title">原文内容</span>
        <span class="fold-meta"><%= typeof domain !== 'undefined' && domain ? domain : (link.og_site_name || '') %></span>
        <span class="fold-toggle"><span class="when-closed">展开 ▾</span><span class="when-open">收起 ▴</span></span>
      </summary>
      <div class="fold-body">
        <div class="markdown-body"><%- markdownHtml %></div>
      </div>
    </details>
    <% } %>

    <% } %>

    <% if (relatedLinks.length > 0 || relatedNotes.length > 0) { %>
    <div class="divider"></div>
    <% } %>

    <% if (relatedLinks.length > 0) { %>
    <h2 class="section-h2" style="margin-bottom:4px">相关链接 <span class="h2-count">· <%= relatedLinks.length %></span></h2>
    <% for (const l of relatedLinks) { %>
    <div class="related-item">
      <div class="related-title-row">
        <% if (typeof isShared !== 'undefined' && isShared) { %>
        <span class="related-title"><%= l.title || l.sourceUrl || '' %></span>
        <% } else { %>
        <a href="<%= l.url %>"><%= l.title || l.url || '' %></a>
        <% } %>
        <% if (l.score) { %>
        <span class="related-score">[<%= Math.round(l.score * 100) / 100 %>]</span>
        <% } %>
      </div>
      <% if (l.snippet) { %>
      <div class="related-quote">
        <p><span class="q-label">摘要</span><%= l.snippet %></p>
      </div>
      <% } %>
      <div class="related-foot">
        <a href="<%= l.sourceUrl %>" target="_blank"><%= l.sourceUrl %></a>
        <% if (l.tags && l.tags.length > 0 && (typeof isShared === 'undefined' || !isShared)) { %>
        · <%= l.tags.join(' · ') %>
        <% } %>
      </div>
    </div>
    <% } %>
    <% } %>

    <% if (relatedNotes.length > 0) { %>
    <h2 class="section-h2" style="margin:24px 0 4px">相关笔记 <span class="h2-count">· <%= relatedNotes.length %></span></h2>
    <% for (const n of relatedNotes) { %>
    <div class="related-item">
      <%
        const noteName = noteFilename(n.path);
        // heading: prefer dedicated field, fall back to title if it differs from filename
        const heading = n.heading || (n.title && n.title !== noteName ? n.title : '');
      %>
      <div class="related-title-row">
        <% if (n.noteUrl) { %>
        <a href="<%= textFragmentUrl(n.noteUrl, n.snippet) %>"><%= noteName %></a>
        <% } else { %>
        <span class="related-title"><%= noteName %></span>
        <% } %>
        <% if (heading) { %>
        <span class="related-score">§ <%= heading %></span>
        <% } %>
      </div>
      <% if (n.snippet) { %>
      <div class="related-quote">
        <p><span class="q-label">片段</span><%= n.snippet.slice(0, 150) %></p>
      </div>
      <% } %>
    </div>
    <% } %>
    <% } %>

    <% if (typeof isAdmin !== 'undefined' && isAdmin) { %>
    <%
      const session = typeof agentSession !== 'undefined' ? agentSession : null;
      const events = typeof agentEvents !== 'undefined' ? agentEvents : [];
      const txns = typeof recordTransactions !== 'undefined' ? recordTransactions : [];
      const totalCost = txns.reduce((sum, t) => sum + Number(t.amount_usd), 0);

      function formatEventTime(dateStr) {
        if (!dateStr) return '';
        const d = new Date(dateStr);
        return d.toLocaleTimeString('zh-CN', { hour12: false });
      }

      function formatDuration(ms) {
        if (ms == null) return '';
        if (ms < 1000) return ms + 'ms';
        return (ms / 1000).toFixed(1) + 's';
      }

      function eventLabel(evt) {
        if (evt.event_type === 'step_start') return evt.name || 'step';
        if (evt.event_type === 'step_end') return evt.name || 'step';
        if (evt.event_type === 'message') {
          const data = typeof evt.data === 'string' ? JSON.parse(evt.data) : evt.data;
          return data?.message || 'message';
        }
        if (evt.event_type === 'session_start') return 'Session started';
        if (evt.event_type === 'session_end') {
          const data = typeof evt.data === 'string' ? JSON.parse(evt.data) : evt.data;
          return data?.status === 'failed' ? 'Session failed' : 'Session completed';
        }
        return evt.event_type;
      }

      function eventDuration(evt) {
        if (evt.event_type !== 'step_end') return null;
        const data = typeof evt.data === 'string' ? JSON.parse(evt.data) : evt.data;
        return data?.durationMs;
      }
    %>
    <details class="fold" id="pipelineFold">
      <summary>
        <span class="pipe-badge <%= session ? session.status : '' %>" id="pipeStatusBadge"><%= session ? String(session.status).toUpperCase() : 'PIPELINE' %></span>
        <span class="fold-meta" id="pipeMeta">
          <% if (session) { %><%= session.agent_name %> · <%= formatEventTime(session.created_at) %><% } %>
          <% if (txns.length > 0) { %> · $<%= totalCost.toFixed(6) %><% } %>
        </span>
        <span class="fold-toggle"><span class="when-closed">展开处理记录 ▾</span><span class="when-open">收起 ▴</span></span>
      </summary>
      <div class="fold-body">
        <div style="display:flex;align-items:center;gap:10px;margin-bottom:14px">
          <button class="btn-solid" id="rerunBtn" style="touch-action:manipulation">Rerun</button>
          <span class="rerun-status" id="rerunStatus"></span>
        </div>
        <div class="mono-label">PROCESSING HISTORY</div>
        <div id="eventTimeline">
          <% for (const evt of events) { %>
          <div class="event-item">
            <span class="event-time"><%= formatEventTime(evt.created_at) %></span>
            <span><span class="event-type<%= evt.event_type.indexOf('session') === 0 ? ' is-session' : '' %>"><%= evt.event_type.replace('_', ' ').toUpperCase() %></span></span>
            <span class="event-text">
              <%= eventLabel(evt) %><% const dur = eventDuration(evt); if (dur != null) { %> (<%= formatDuration(dur) %>)<% } %>
            </span>
          </div>
          <% } %>
        </div>
        <% if (txns.length > 0) { %>
        <div class="mono-label" style="margin:18px 0 8px">COST BREAKDOWN (TOTAL: $<%= totalCost.toFixed(6) %>)</div>
        <% for (const t of txns) { %>
        <div class="cost-row">
          <span><%= t.step || '—' %></span>
          <span class="c-dim"><%= t.type %></span>
          <span class="c-dim"><%= t.provider %></span>
          <span>$<%= Number(t.amount_usd).toFixed(6) %></span>
        </div>
        <% } %>
        <% } %>
      </div>
    </details>
    <% } /* end isAdmin */ %>

  </div>
</div>

<% if (typeof isShared === 'undefined' || !isShared) { %>
<script>
  function shareRecord() {
    if (!confirm('确认公开分享此链接？')) return;
    const btn = document.getElementById('shareBtn');
    btn.disabled = true;
    btn.textContent = 'Sharing...';

    fetch('/api/links/<%= link.id %>/share', { method: 'POST' })
      .then(r => r.json())
      .then(data => {
        // Copy full URL to clipboard
        const fullUrl = location.origin + data.url;
        navigator.clipboard.writeText(fullUrl).then(() => {
          alert('分享链接已复制到剪贴板：\n' + fullUrl);
        }).catch(() => {
          alert('分享链接：\n' + fullUrl);
        });
        // Reload to show updated button state
        location.reload();
      })
      .catch(err => {
        btn.disabled = false;
        btn.textContent = 'Share';
        alert('分享失败：' + err.message);
      });
  }

  function stopSharing() {
    if (!confirm('确认停止分享？停止后分享链接将不可访问。')) return;
    const btn = document.getElementById('shareBtn');
    btn.disabled = true;
    btn.textContent = 'Stopping...';

    fetch('/api/links/<%= link.id %>/share', { method: 'DELETE' })
      .then(r => r.json())
      .then(() => {
        location.reload();
      })
      .catch(err => {
        btn.disabled = false;
        btn.textContent = 'Stop Sharing';
        alert('操作失败：' + err.message);
      });
  }
</script>
<% } %>

<% if (typeof isAdmin !== 'undefined' && isAdmin) { %>
<script>
  const recordId = <%= link.id %>;
  const initialSessionId = '<%= typeof agentSession !== 'undefined' && agentSession ? agentSession.id : '' %>';
  const initialSessionStatus = '<%= typeof agentSession !== 'undefined' && agentSession ? agentSession.status : '' %>';

  function setPipeBadge(status) {
    const badge = document.getElementById('pipeStatusBadge');
    if (!badge) return;
    badge.textContent = String(status).toUpperCase();
    badge.className = 'pipe-badge ' + status;
  }

  function rerunRecord(attempt) {
    attempt = attempt || 1;
    const btn = document.getElementById('rerunBtn');
    const status = document.getElementById('rerunStatus');
    btn.disabled = true;
    btn.textContent = 'Rerunning...';
    status.textContent = attempt > 1 ? 'Retrying...' : 'Starting...';

    fetch('/api/retry/' + recordId, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: '{}' })
      .then(r => { if (!r.ok) throw new Error('HTTP ' + r.status); return r.json(); })
      .then(data => {
        status.textContent = 'Queued (taskId: ' + (data.taskId || '?') + ')';
        // Start polling for new session
        setTimeout(() => pollForSession(), 2000);
      })
      .catch(err => {
        console.error('Rerun fetch failed (attempt ' + attempt + '):', err.name, err.message);
        if (attempt < 3 && err instanceof TypeError) {
          // Auto-retry on network errors (e.g. "Load failed")
          setTimeout(() => rerunRecord(attempt + 1), 500);
          return;
        }
        btn.disabled = false;
        btn.textContent = 'Rerun';
        status.textContent = 'Error: ' + err.message;
      });
  }

  function pollForSession() {
    fetch('/api/records/' + recordId + '/session')
      .then(r => r.json())
      .then(data => {
        if (data.session && data.session.status === 'running') {
          setPipeBadge('running');
          startSSE(data.session.id);
        } else {
          // Session not ready yet, keep polling
          setTimeout(() => pollForSession(), 1000);
        }
      });
  }

  function startSSE(sessionId) {
    const tl = document.getElementById('eventTimeline');
    tl.innerHTML = '';
    const fold = document.getElementById('pipelineFold');
    if (fold) fold.open = true;

    const es = new EventSource('/api/agent-events/stream?session_id=' + sessionId + '&cursor=0');
    es.addEventListener('agent_event', function(e) {
      const evt = JSON.parse(e.data);
      const item = document.createElement('div');
      item.className = 'event-item';

      const time = new Date(evt.created_at).toLocaleTimeString('zh-CN', { hour12: false });
      const isSession = evt.event_type.indexOf('session') === 0;
      const typeLabel = evt.event_type.replace('_', ' ').toUpperCase();

      let label = '';
      if (evt.event_type === 'step_start' || evt.event_type === 'step_end') {
        label = evt.name || 'step';
      } else if (evt.event_type === 'message') {
        const data = typeof evt.data === 'string' ? JSON.parse(evt.data) : evt.data;
        label = data?.message || 'message';
      } else if (evt.event_type === 'session_start') {
        label = 'Session started';
      } else if (evt.event_type === 'session_end') {
        const data = typeof evt.data === 'string' ? JSON.parse(evt.data) : evt.data;
        label = data?.status === 'failed' ? 'Session failed' : 'Session completed';
      }

      if (evt.event_type === 'step_end') {
        const data = typeof evt.data === 'string' ? JSON.parse(evt.data) : evt.data;
        if (data?.durationMs != null) {
          const ms = data.durationMs;
          label += ' (' + (ms < 1000 ? ms + 'ms' : (ms/1000).toFixed(1) + 's') + ')';
        }
      }

      const timeEl = document.createElement('span');
      timeEl.className = 'event-time';
      timeEl.textContent = time;
      const badgeWrap = document.createElement('span');
      const badge = document.createElement('span');
      badge.className = 'event-type' + (isSession ? ' is-session' : '');
      badge.textContent = typeLabel;
      badgeWrap.appendChild(badge);
      const textEl = document.createElement('span');
      textEl.className = 'event-text';
      textEl.textContent = label;
      item.appendChild(timeEl);
      item.appendChild(badgeWrap);
      item.appendChild(textEl);

      tl.appendChild(item);
      tl.scrollTop = tl.scrollHeight;

      // Update status on session_end
      if (evt.event_type === 'session_end') {
        es.close();
        const btn = document.getElementById('rerunBtn');
        btn.disabled = false;
        btn.textContent = 'Rerun';
        const data = typeof evt.data === 'string' ? JSON.parse(evt.data) : evt.data;
        const status = data?.status === 'failed' ? 'failed' : 'completed';
        setPipeBadge(status);
        document.getElementById('rerunStatus').textContent = status;
      }
    });

    es.onerror = function() {
      es.close();
      const btn = document.getElementById('rerunBtn');
      btn.disabled = false;
      btn.textContent = 'Rerun';
    };
  }

  // Auto-connect SSE if session is running on page load
  if (initialSessionStatus === 'running' && initialSessionId) {
    startSSE(initialSessionId);
  }

  // Bind rerun button — use touchend on mobile to avoid tap/click issues
  (function() {
    const btn = document.getElementById('rerunBtn');
    if (!btn) return;
    let handled = false;
    btn.addEventListener('touchend', function(e) {
      e.preventDefault();
      if (handled) return;
      handled = true;
      rerunRecord();
      setTimeout(() => { handled = false; }, 1000);
    });
    btn.addEventListener('click', function(e) {
      if (handled) { e.preventDefault(); return; }
      handled = true;
      rerunRecord();
      setTimeout(() => { handled = false; }, 1000);
    });
  })();
</script>
<% } /* end isAdmin script */ %>
