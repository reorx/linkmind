<style>
  .list-panel {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 2px;
    overflow: hidden;
  }
  .list-head {
    display: grid;
    grid-template-columns: 56px 1fr 140px;
    gap: 16px;
    padding: 8px 18px;
    background: var(--head-bg);
    border-bottom: 1px solid var(--border-light);
  }
  .list-head span {
    font-size: 10.5px;
    font-weight: 600;
    letter-spacing: .05em;
    color: var(--dim);
  }
  .list-head span:last-child { text-align: right; }
  .group-head {
    padding: 7px 18px;
    background: var(--bg);
    border-bottom: 1px solid var(--border-light);
    display: flex;
    align-items: baseline;
    gap: 10px;
  }
  .group-head .g-date {
    font-size: 11.5px;
    font-weight: 700;
    color: var(--text);
  }
  .group-head .g-count {
    font-family: var(--mono);
    font-size: 9.5px;
    color: var(--faint);
  }
  .list-row {
    display: grid;
    grid-template-columns: 56px 1fr 140px;
    gap: 16px;
    padding: 13px 18px;
    border-bottom: 1px solid var(--border-row);
    align-items: baseline;
    background: var(--surface);
    text-decoration: none;
    color: inherit;
  }
  .list-row:hover {
    background: var(--accent-bg);
    text-decoration: none;
    color: inherit;
  }
  .row-time {
    font-family: var(--mono);
    font-size: 10.5px;
    color: var(--faint);
  }
  .row-main { min-width: 0; }
  .row-title {
    font-size: 14px;
    font-weight: 600;
    color: var(--text);
    line-height: 1.4;
    overflow-wrap: break-word;
    word-break: break-word;
  }
  .row-summary {
    font-size: 12px;
    color: #55585c;
    line-height: 1.6;
    margin-top: 4px;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .row-error {
    font-size: 12px;
    color: var(--error-text);
    line-height: 1.6;
    margin-top: 4px;
  }
  .row-tags {
    font-size: 11px;
    color: var(--accent);
    margin-top: 5px;
  }
  .row-domain {
    font-size: 11px;
    color: var(--faint);
    text-align: right;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .status-badge {
    display: inline-block;
    font-family: var(--mono);
    font-size: 9px;
    font-weight: 600;
    letter-spacing: .04em;
    padding: 1.5px 6px;
    border-radius: 2px;
    margin-left: 8px;
    vertical-align: 1px;
    white-space: nowrap;
  }
  .status-badge.error { background: var(--error-bg); color: var(--error-text); }
  .status-badge.pending { background: var(--badge-pending-bg); color: var(--badge-pending-text); }
  .status-badge.scraped { background: var(--badge-scraped-bg); color: var(--badge-scraped-text); }
  .status-badge.note { background: var(--tag-bg); color: var(--dim); }
  .pagination {
    display: flex;
    gap: 6px;
    justify-content: center;
    padding: 24px 0 0;
    flex-wrap: wrap;
  }
  .pagination a, .pagination span {
    display: inline-block;
    padding: 4px 10px;
    border-radius: 2px;
    font-family: var(--mono);
    font-size: 11px;
    text-decoration: none;
  }
  .pagination a {
    background: var(--surface);
    border: 1px solid var(--border);
    color: var(--body-text);
  }
  .pagination a:hover {
    border-color: var(--text);
    color: var(--text);
    text-decoration: none;
  }
  .pagination .current {
    background: var(--text);
    border: 1px solid var(--text);
    color: var(--surface);
    font-weight: 600;
  }
  .empty-state {
    text-align: center;
    color: var(--dim);
    padding: 60px 0;
    font-size: 14px;
  }
  @media (max-width: 600px) {
    .list-head { grid-template-columns: 44px 1fr; }
    .list-head span:last-child { display: none; }
    .list-row { grid-template-columns: 44px 1fr; gap: 10px; padding: 12px 14px; }
    .row-domain { display: none; }
  }
</style>

<% if (groups.length === 0) { %>
<div class="empty-state">还没有收藏任何内容</div>
<% } else { %>
<div class="list-panel">
  <div class="list-head">
    <span>时间</span>
    <span>标题 / 摘要</span>
    <span>来源</span>
  </div>
  <% for (const g of groups) { %>
  <div class="group-head">
    <span class="g-date"><%= g.date %></span>
    <span class="g-count"><%= g.items.length %> 条</span>
  </div>
    <% for (const item of g.items) { %>
    <a class="list-row" href="/link/<%= item.id %>">
      <span class="row-time"><%= item._time %></span>
      <div class="row-main">
        <div class="row-title">
          <%= item.type === 'note' ? ((item.content || '').slice(0, 60) || 'Untitled Note') : (item.og_title || item.url) %>
          <% if (item.type === 'note') { %>
          <span class="status-badge note">笔记</span>
          <% } %>
          <% if (item.status === 'error') { %>
          <span class="status-badge error">失败</span>
          <% } else if (item.status === 'enqueued' || item.status === 'pending') { %>
          <span class="status-badge pending">处理中</span>
          <% } else if (item.status === 'scraped') { %>
          <span class="status-badge scraped">分析中</span>
          <% } else if (item.status === 'waiting_probe') { %>
          <span class="status-badge pending">等待抓取</span>
          <% } %>
        </div>
        <% if (item._summaryText) { %>
        <div class="row-summary"><%= item._summaryText %></div>
        <% } else if (item.error_message) { %>
        <div class="row-error"><%= item.error_message %></div>
        <% } %>
        <% if (item._tags && item._tags.length > 0) { %>
        <div class="row-tags"><%= item._tags.join(' · ') %></div>
        <% } %>
      </div>
      <span class="row-domain"><%= item._domain %></span>
    </a>
    <% } %>
  <% } %>
</div>

<% if (totalPages > 1) { %>
<div class="pagination">
  <% if (page > 1) { %>
  <a href="/?page=<%= page - 1 %>">← 上一页</a>
  <% } %>
  <% for (let i = 1; i <= totalPages; i++) { %>
    <% if (i === page) { %>
    <span class="current"><%= i %></span>
    <% } else if (Math.abs(i - page) <= 2 || i === 1 || i === totalPages) { %>
    <a href="/?page=<%= i %>"><%= i %></a>
    <% } else if (Math.abs(i - page) === 3) { %>
    <span style="color:var(--faint)">…</span>
    <% } %>
  <% } %>
  <% if (page < totalPages) { %>
  <a href="/?page=<%= page + 1 %>">下一页 →</a>
  <% } %>
</div>
<% } %>
<% } %>
