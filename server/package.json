{
  "name": "@linkmind/server",
  "version": "0.1.0",
  "description": "Link collector + deep analysis agent via Telegram",
  "type": "module",
  "scripts": {
    "dev": "tsx src/index.ts",
    "dev:cli": "tsx src/cli.ts",
    "build": "tsc -p tsconfig.build.json && cp -r src/views dist/views && mkdir -p dist/db/migrations",
    "start": "node dist/index.js",
    "cli": "node dist/cli.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.998.0",
    "@linkmind/core": "workspace:*",
    "@sentry/node": "^10.38.0",
    "@types/multer": "^2.0.0",
    "absurd-sdk": "^0.0.7",
    "cookie-parser": "^1.4.7",
    "crawlee": "^3.16.0",
    "defuddle": "^0.6.6",
    "dotenv": "^17.0.0",
    "ejs": "^4.0.1",
    "express": "^5.1.0",
    "grammy": "^1.35.0",
    "jsonwebtoken": "^9.0.3",
    "kysely": "^0.28.11",
    "marked": "^17.0.3",
    "multer": "^2.0.2",
    "nanoid": "^5.1.6",
    "openai": "^4.80.0",
    "pg": "^8.18.0",
    "pino": "^10.3.0",
    "pino-pretty": "^13.1.3",
    "playwright": "^1.50.0",
    "playwright-extra": "^4.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "tsx": "^4.21.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/cookie-parser": "^1.4.10",
    "@types/ejs": "^3.1.5",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.16.0",
    "better-sqlite3": "^12.6.2",
    "typescript": "^5.7.0",
    "vitest": "^4.0.18"
  }
}
